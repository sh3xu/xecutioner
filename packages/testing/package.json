{
  "name": "@xecutioner/testing",
  "version": "0.1.0",
  "description": "Mocks, conformance fixtures, and eval harness stubs for Xecutioner",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@xecutioner/protocol": "workspace:*",
    "@xecutioner/react-native": "workspace:*",
    "@xecutioner/server": "workspace:*",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/ws": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
