{
  "name": "@xecutioner/protocol",
  "version": "0.1.0",
  "description": "Wire protocol schemas, types, and shared helpers for Xecutioner UI control",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist src/generated"
  },
  "devDependencies": {
    "json-schema-to-typescript": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
